flowchart LR
    Main["Main<br/>«client»<br/>the only client"]
    CFG["HotelConfiguration<br/>composition root<br/>wires the concrete classes"]
    FD["FrontDesk «Facade»<br/>(domain.service)<br/>single entry point"]

    subgraph calendar["domain.calendar  «Adapter»"]
        direction LR
        CE["CalendarExporter «interface»<br/>export(code, reservation)"]
        ICS["IcsCalendarExporter<br/>LocalDate → Date<br/>reservation → VEvent"]
    end

    subgraph lib["biweekly library"]
        BW["ICalendar · VEvent · Biweekly<br/>Biweekly.write(ical).go()"]
    end

    subgraph pricing["domain.pricing  «Decorator»"]
        direction LR
        POL["PricingPolicy<br/>RuleBasedPricingPolicy"]
        PA["TouristTax / LoyaltyDiscount /<br/>WeekendSurcharge<br/>(PriceAdjustment)"]
        BP["BasePrice<br/>(PriceCalculator)"]
    end

    subgraph payment["domain.payment"]
        PM["PaymentMethod «interface»<br/>CashPayment · CardPayment"]
        PF["PayFlowClient<br/>simulated card gateway"]
    end

    subgraph service["domain.service"]
        direction LR
        BS["BookingSystem «interface»<br/>InMemoryBookingSystem"]
        G["ReservationNumberGenerator<br/>«Singleton» (Lab 1)"]
    end

    subgraph lab1["Lab 1 creational patterns"]
        direction LR
        RF["RoomFactory + subclasses<br/>«Factory Method»"]
        RB["Reservation.Builder ·<br/>ReservationDirector «Builder»"]
    end

    Main -- "openRoom · quote · bookRoom ·<br/>bookWeekendGetaway · bookBusinessTrip" --> FD
    Main -. "frontDesk()" .-> CFG
    FD -- "pricingFor(guest)" --> POL
    POL -- "stacks" --> PA
    PA -- "wraps" --> BP
    FD -- "pay()" --> PM
    PM --> PF
    FD -- "export()" --> CE
    CE --> ICS
    ICS -- "calls" --> BW
    FD -- "find room · book · cancel" --> BS
    BS -- "next()" --> G
    FD -- "open rooms" --> RF
    FD -- "build reservation" --> RB

    classDef facade fill:#fff3d6,stroke:#c98a00,stroke-width:2px,color:#000
    classDef adapter fill:#e8f1fd,stroke:#2c6db5,stroke-width:2px,color:#000
    classDef decorator fill:#e8f8ec,stroke:#27864a,stroke-width:2px,color:#000
    classDef ext fill:#eeeeee,stroke:#666,stroke-dasharray: 4 3,color:#000
    classDef plain fill:#f7f7f7,stroke:#999,color:#000
    class FD facade
    class CE,ICS adapter
    class POL,PA,BP decorator
    class BW ext
    class Main,CFG,BS,G,RF,RB,PM,PF plain
